{% comment %}
  =========================================================================
  Pokémon Store Footer — Shopify Section (Liquid + Tailwind v4 ready)
  =========================================================================
  HOW IT WORKS (read me first):

  1) A Shopify "section" is a chunk of theme HTML the merchant can configure
     in Theme Editor (Customize). The {% schema %} block at the bottom of
     this file defines what settings & blocks appear in the editor.

  2) The merchant adds "blocks" (Help, Link list, Newsletter) and changes
     "settings" (colors, padding, copyright text). Liquid reads those values
     here via `section.settings.*` and `block.settings.*`.

  3) Colors set in the editor are injected as CSS custom properties (vars)
     on the <footer> root. The <style> tag below then uses those vars so
     everything stays theme-editable without rebuilding CSS.

  4) Tailwind v4 is loaded globally (layout/theme.liquid), but Shopify's
     Dawn base CSS also ships its own .grid / ul / a styles that fight us.
     We use scoped class names like .pkmn-* + a few !important rules so
     our footer renders correctly regardless of Dawn's defaults.
  =========================================================================
{% endcomment %}

{%- comment -%}
  The <footer> is the root element.
  - `style=""` is where we set CSS variables from section settings.
    Why CSS vars? They let the editor's color pickers update the page
    without rebuilding any stylesheet.
  - Padding is reduced 25% on mobile for a tighter feel; full value at >=750px
    (override is in the <style> block further down).
{%- endcomment -%}
<footer
  class="pkmn-footer"
  style="
    --pkmn-bg: {{ section.settings.bg_color }};
    --pkmn-text: {{ section.settings.text_color }};
    --pkmn-heading: {{ section.settings.heading_color }};
    --pkmn-muted: {{ section.settings.muted_color }};
    --pkmn-border: {{ section.settings.border_color }};
    --pkmn-input: {{ section.settings.input_bg }};
    --pkmn-accent: {{ section.settings.accent_color }};
    background: var(--pkmn-bg);
    color: var(--pkmn-text);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  "
>
  {%- comment -%}
    All footer-specific CSS lives here. Keeping styles inside the section
    means this file is self-contained — drop it into any theme and it works.
    For production you'd extract this into assets/section-footer-pokemon.css.
  {%- endcomment -%}
  <style>
    /* Container — fluid responsive padding */
    .pkmn-container {
      width: 100%;
      max-width: 1440px;
      margin-inline: auto;
      padding-inline: 20px;
    }
    @media (min-width: 480px) { .pkmn-container { padding-inline: 24px; } }
    @media (min-width: 750px) { .pkmn-container { padding-inline: 40px; } }
    @media (min-width: 1200px) { .pkmn-container { padding-inline: 56px; } }

    /* Grid — mobile-first */
    .pkmn-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
    }
    @media (min-width: 600px) {
      .pkmn-grid { grid-template-columns: 1fr 1fr; gap: 36px 32px; }
    }
    @media (min-width: 990px) {
      .pkmn-grid { grid-template-columns: 1.4fr 1fr 1fr 1.5fr; gap: 56px; }
    }

    /* Headings — override Dawn defaults */
    .pkmn-footer .pkmn-heading {
      color: var(--pkmn-heading) !important;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.2px;
      margin: 0 0 20px;
      line-height: 1.3;
      font-family: inherit;
    }
    @media (min-width: 990px) {
      .pkmn-footer .pkmn-heading { font-size: 17px; margin-bottom: 22px; }
    }

    /* Body text */
    .pkmn-footer p,
    .pkmn-footer li,
    .pkmn-footer .pkmn-text {
      color: var(--pkmn-text);
      font-size: 14px;
      line-height: 1.7;
      margin: 0;
    }
    .pkmn-footer p + p,
    .pkmn-footer p + .pkmn-text { margin-top: 12px; }

    /* Links — strip Dawn underlines */
    .pkmn-footer a {
      color: var(--pkmn-text);
      text-decoration: none !important;
      background-image: none !important;
      transition: color .15s ease;
    }
    .pkmn-footer a:hover { color: var(--pkmn-accent); }

    /* Link list */
    .pkmn-footer ul, .pkmn-footer ol { list-style: none; margin: 0; padding: 0; }
    .pkmn-footer li { list-style: none; margin: 0 0 12px; padding: 0; }
    .pkmn-footer li:last-child { margin-bottom: 0; }
    .pkmn-footer li::before, .pkmn-footer li::marker { content: none; }

    /* Contact block */
    .pkmn-contact { margin-top: 18px; }
    .pkmn-contact > div { margin-bottom: 6px; }
    .pkmn-contact > div:last-child { margin-bottom: 0; }

    /* Social icons */
    .pkmn-socials { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; }
    .pkmn-social {
      width: 40px; height: 40px;
      display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid var(--pkmn-border);
      border-radius: 9999px;
      transition: background .15s, border-color .15s, transform .15s;
    }
    .pkmn-social:hover { background: var(--pkmn-accent); border-color: var(--pkmn-accent); transform: translateY(-2px); }
    .pkmn-social svg { width: 16px; height: 16px; fill: var(--pkmn-text); transition: fill .15s; }
    .pkmn-social:hover svg { fill: #000; }

    /* Newsletter */
    .pkmn-newsletter {
      display: flex;
      align-items: center;
      background: var(--pkmn-input);
      border-radius: 9999px;
      padding: 6px;
      margin-top: 18px;
      max-width: 460px;
      width: 100%;
    }
    .pkmn-newsletter input {
      flex: 1; min-width: 0;
      background: transparent; border: 0; outline: 0;
      color: var(--pkmn-text);
      font-size: 14px;
      padding: 12px 16px;
      font-family: inherit;
    }
    .pkmn-newsletter input::placeholder { color: var(--pkmn-muted); }
    .pkmn-newsletter button {
      background: #fff; color: #000;
      border: 0; border-radius: 9999px;
      padding: 12px 22px;
      font-weight: 600; font-size: 14px;
      cursor: pointer;
      white-space: nowrap;
      transition: background .15s ease;
    }
    .pkmn-newsletter button:hover { background: var(--pkmn-accent); }
    .pkmn-fine {
      font-size: 12px;
      line-height: 1.6;
      color: var(--pkmn-muted);
      margin-top: 18px;
      max-width: 460px;
    }
    .pkmn-fine strong, .pkmn-fine b { color: var(--pkmn-text); font-weight: 600; }
    .pkmn-fine p { color: var(--pkmn-muted); font-size: 12px; line-height: 1.6; margin: 0; }

    /* Bottom bar */
    .pkmn-bottom {
      border-top: 1px solid var(--pkmn-border);
      margin-top: 40px;
      padding-top: 22px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    @media (min-width: 750px) {
      .pkmn-bottom { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 56px; }
    }
    .pkmn-bottom-left { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 13px; color: var(--pkmn-muted); align-items: center; }
    .pkmn-bottom-left span { font-size: 13px; line-height: 1.5; }
    .pkmn-region { display: inline-flex; align-items: center; gap: 6px; color: var(--pkmn-text); }
    .pkmn-payments { display: flex; gap: 8px; flex-wrap: wrap; }
    .pkmn-payments li { margin: 0; }
    .pkmn-payments svg { height: 22px; width: auto; display: block; }

    /* Desktop padding override */
    @media (min-width: 750px) {
      .pkmn-footer { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
    }
  </style>

  {%- comment -%}
    .pkmn-container = centered, max 1440px wide, responsive horizontal padding.
    .pkmn-grid      = 1 col on mobile, 2 cols on tablet, 4 cols on desktop.
  {%- endcomment -%}
  <div class="pkmn-container">
    <div class="pkmn-grid">
      {%- comment -%}
        `section.blocks` is the array of blocks the merchant added in the
        editor. We loop over them and render the right markup based on
        each block's `type` (defined in {% schema %} at the bottom).

        `block.shopify_attributes` is required so the theme editor can
        select/highlight the block when clicked.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'help' -%}
              {%- comment -%} Column 1: heading, description, phone, email, social icons. {%- endcomment -%}
              <h3 class="pkmn-heading">{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
              <div class="pkmn-contact">
                {%- if block.settings.phone != blank -%}<div>{{ block.settings.phone }}</div>{%- endif -%}
                {%- if block.settings.email != blank -%}<div>{{ block.settings.email }}</div>{%- endif -%}
              </div>
              {%- comment -%}
                Each social icon only renders if a URL is set in the editor.
                The inline SVG saves an HTTP request and inherits color via `fill`.
              {%- endcomment -%}
              {%- if block.settings.show_socials -%}
                <div class="pkmn-socials">
                  {%- if block.settings.facebook != blank -%}
                    <a href="{{ block.settings.facebook }}" aria-label="Facebook" class="pkmn-social"><svg viewBox="0 0 24 24"><path d="M13 22v-8h3l1-4h-4V7.5c0-1.1.3-1.9 1.9-1.9H17V2.1C16.6 2.1 15.4 2 14 2c-2.9 0-4.9 1.8-4.9 5v3H6v4h3v8h4z"/></svg></a>
                  {%- endif -%}
                  {%- if block.settings.instagram != blank -%}
                    <a href="{{ block.settings.instagram }}" aria-label="Instagram" class="pkmn-social"><svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.4a4.4 4.4 0 100 8.8 4.4 4.4 0 000-8.8zm0 7.3a2.9 2.9 0 110-5.8 2.9 2.9 0 010 5.8zm5.6-7.5a1 1 0 11-2 0 1 1 0 012 0z"/></svg></a>
                  {%- endif -%}
                  {%- if block.settings.tiktok != blank -%}
                    <a href="{{ block.settings.tiktok }}" aria-label="TikTok" class="pkmn-social"><svg viewBox="0 0 24 24"><path d="M21 8.4a7.5 7.5 0 01-4.4-1.4v6.7a5.7 5.7 0 11-5.7-5.7c.3 0 .6 0 .8.1v2.7a3 3 0 102 2.8V2h2.6a4.9 4.9 0 004.7 4.7v1.7z"/></svg></a>
                  {%- endif -%}
                  {%- if block.settings.youtube != blank -%}
                    <a href="{{ block.settings.youtube }}" aria-label="YouTube" class="pkmn-social"><svg viewBox="0 0 24 24"><path d="M23.5 6.5a3 3 0 00-2.1-2.1C19.5 4 12 4 12 4s-7.5 0-9.4.4A3 3 0 00.5 6.5 31 31 0 000 12a31 31 0 00.5 5.5 3 3 0 002.1 2.1C4.5 20 12 20 12 20s7.5 0 9.4-.4a3 3 0 002.1-2.1A31 31 0 0024 12a31 31 0 00-.5-5.5zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg></a>
                  {%- endif -%}
                  {%- if block.settings.pinterest != blank -%}
                    <a href="{{ block.settings.pinterest }}" aria-label="Pinterest" class="pkmn-social"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 00-3.6 19.3c-.1-.8-.2-2 0-2.9l1.3-5.4s-.3-.7-.3-1.6c0-1.5.9-2.7 2-2.7.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 1.9 1.6 1.9 1.9 0 3.4-2 3.4-5 0-2.6-1.9-4.4-4.5-4.4-3.1 0-4.9 2.3-4.9 4.7 0 .9.4 1.9.8 2.5.1.1.1.2.1.3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.6-2.1-4.1 0-3.4 2.4-6.5 7-6.5 3.7 0 6.5 2.6 6.5 6.1 0 3.7-2.3 6.6-5.5 6.6-1.1 0-2-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.4 2.8A10 10 0 1012 2z"/></svg></a>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'links' -%}
              {# Renders a Shopify menu (chosen in the theme editor) as a clean link list. #}
              <h3 class="pkmn-heading">{{ block.settings.heading }}</h3>
              {%- if block.settings.menu != blank -%}
                <ul>
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- comment -%} Email signup. Shopify's form 'customer' tag handles the submission/validation. {%- endcomment -%}
              <h3 class="pkmn-heading">{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
              {%- form 'customer' -%}
                {# Tagging the contact so you can filter newsletter signups in Shopify admin. #}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="pkmn-newsletter">
                  <input
                    type="email"
                    name="contact[email]"
                    placeholder="{{ block.settings.placeholder | default: 'Enter your email...' }}"
                    required
                    aria-label="Email"
                  >
                  <button type="submit">{{ block.settings.button_label | default: 'Sign Up' }}</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="pkmn-fine" style="color:var(--pkmn-accent);">Thanks for subscribing! Your Poké Ball of deals is on the way.</p>
                {%- endif -%}
                {%- if block.settings.fine_print != blank -%}
                  <div class="pkmn-fine">{{ block.settings.fine_print }}</div>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%}
      Bottom bar — sits below all blocks, separated by a top border.
      Left side: region label + copyright.   Right side: payment-method icons.
      `{{ 'now' | date: '%Y' }}` prints the current year automatically.
    {%- endcomment -%}
    <div class="pkmn-bottom">
      <div class="pkmn-bottom-left">
        {%- if section.settings.show_region -%}
          <span class="pkmn-region">
            {{ section.settings.region_label }}
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5"/></svg>
          </span>
        {%- endif -%}
        <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name }}. All rights reserved.</span>
      </div>
      {%- comment -%}
        `shop.enabled_payment_types` is a built-in Shopify global. It returns
        the list of payment methods enabled in Settings → Payments.
        The `payment_type_svg_tag` filter outputs the brand SVG (Visa, etc.).
      {%- endcomment -%}
      {%- if section.settings.show_payments -%}
        <ul class="pkmn-payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'pkmn-pay' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- comment -%}
  =========================================================================
  SCHEMA — controls what appears in the Theme Editor sidebar.
  =========================================================================
  - "settings"   : section-wide controls (colors, padding). Read via
                   `section.settings.bg_color` etc. in the markup above.
  - "blocks"     : repeatable child items the merchant can add/remove/reorder.
                   Each has its own settings, read via `block.settings.*`.
  - "presets"    : the default starting layout shown when a merchant first
                   adds this section.
  - "enabled_on" : restricts where this section can be placed. We set
                   "groups": ["footer"] so it only appears in the footer area.

  Setting "type" cheat-sheet (most common):
    text, textarea, richtext, inline_richtext, url, image_picker, color,
    checkbox, range (slider), select, link_list (menu picker), header (label).
  =========================================================================
{%- endcomment -%}
{% schema %}
{
  "name": "Pokémon Footer",
  "tag": "section",
  "class": "pkmn-footer-section",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0b0b0b" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#cfcfcf" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8a8a8a" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#2a2a2a" },
    { "type": "color", "id": "input_bg", "label": "Newsletter input bg", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent (Pikachu yellow)", "default": "#FFCB05" },

    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_region", "label": "Show region selector text", "default": true },
    { "type": "text", "id": "region_label", "label": "Region label", "default": "United States (USD $)" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Poké Store" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 32 }
  ],
  "blocks": [
    {
      "type": "help",
      "name": "Help / Contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help Trainers" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Find a Poké Center nearest you for fast shipping and gym-ready support. Show on Google maps." },
        { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (973) 435-3638" },
        { "type": "text", "id": "email", "label": "Email", "default": "trainers@pokestore.com" },
        { "type": "checkbox", "id": "show_socials", "label": "Show social icons", "default": true },
        { "type": "url", "id": "facebook", "label": "Facebook URL" },
        { "type": "url", "id": "instagram", "label": "Instagram URL" },
        { "type": "url", "id": "tiktok", "label": "TikTok URL" },
        { "type": "url", "id": "youtube", "label": "YouTube URL" },
        { "type": "url", "id": "pinterest", "label": "Pinterest URL" }
      ]
    },
    {
      "type": "links",
      "name": "Link list",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our Poké Mart" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Trainer Newsletter" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sign up for 10% off your first catch and free shipping. Get news on rare drops, new sets, and tournament events." },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email..." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign Up" },
        { "type": "richtext", "id": "fine_print", "label": "Fine print", "default": "<p>***By entering your e-mail you accept the <strong>terms and conditions</strong> and the <strong>privacy policy.</strong></p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pokémon Footer",
      "blocks": [
        { "type": "help" },
        { "type": "links", "settings": { "heading": "Our Poké Mart" } },
        { "type": "links", "settings": { "heading": "Shop Pokémon" } },
        { "type": "newsletter" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
